# Initial hosted model. The provider boundary also supports future local/browser adapters.
MODEL_PROVIDER=google_genai
MODEL_NAME=gemini-3.6-flash
GOOGLE_API_KEY=
# GEMINI_API_KEY is also accepted as an alias.
AGENT_EXECUTION_MODE=live

# Optional observability
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=



LANGSMITH_WORKSPACE_ID=
LANGSMITH_PROJECT=water-operations-agentic-harness

# Optional offline/live evaluation configuration
EVAL_DATASET_NAME=Water Operations - Harness Scenarios v1
EVAL_MAX_CONCURRENCY=1
EVAL_REPETITIONS=1
# Optional comma-separated subset for quota-safe smoke runs; empty runs the full corpus.
EVAL_SCENARIO_IDS=
# Run the evaluation asynchronously whenever the backend process starts.
EVAL_RUN_ON_STARTUP=true

NEXT_PUBLIC_API_URL=http://localhost:8000
EVAL_JUDGE_MODEL_NAME=
