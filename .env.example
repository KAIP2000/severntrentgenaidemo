# Initial hosted model. The provider boundary also supports future local/browser adapters.
MODEL_PROVIDER=google_genai
MODEL_NAME=gemini-3.6-flash
GOOGLE_API_KEY=
# GEMINI_API_KEY is also accepted as an alias.
AGENT_EXECUTION_MODE=live

# Optional observability
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
# Set LANGSMITH_WORKSPACE_ID when one key can access multiple workspaces.
# EU: https://eu.api.smith.langchain.com | APAC: https://apac.api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
LANGSMITH_PROJECT=water-operations-agentic-harness

NEXT_PUBLIC_API_URL=http://localhost:8000
